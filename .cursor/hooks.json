{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "node .cursor/hooks/stop-verify.mjs",
        "loop_limit": 3,
        "timeout": 180
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.mjs",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
